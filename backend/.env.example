# DeepSeek API Key（必填，在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型名
DEEPSEEK_MODEL=deepseek-v4-flash

# SQLite 数据库文件路径（默认 backend 目录下 trips.db）
DATABASE_URL=sqlite:///./trips.db

# 小红书 MCP（可选）：留空则禁用小红书搜索，走预置数据兜底。
# 部署 xiaohongshu-mcp 后填 http://127.0.0.1:18060/mcp（见 docs/xhs-mcp.md）
XHS_MCP_URL=

# 高德地图 Web 服务 API（可选）：留空则行程不含真实交通，走纯文本。
# 在 https://lbs.amap.com 注册并完成个人认证，创建应用选「Web 服务」平台，拿到 key 填这里。
AMAP_WEB_KEY=
