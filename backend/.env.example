# DeepSeek API Key（必填，在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型名
DEEPSEEK_MODEL=deepseek-v4-flash

# PostgreSQL 数据库连接（本地开发）
DATABASE_URL=postgresql://travel:travel2026@localhost:5432/travel_planner

# 线上部署时使用 Docker 容器访问宿主机 PostgreSQL
# DATABASE_URL=postgresql://travel:travel2026@host.docker.internal:5432/travel_planner

# 小红书 MCP（可选）：留空则禁用小红书搜索，走预置数据兜底。
# 部署 xiaohongshu-mcp 后填 http://127.0.0.1:18060/mcp（见 docs/xhs-mcp.md）
XHS_MCP_URL=

# 高德地图 Web 服务 API（可选）：留空则行程不含真实交通，走纯文本。
# 在 https://lbs.amap.com 注册并完成个人认证，创建应用选「Web 服务」平台，拿到 key 填这里。
AMAP_WEB_KEY=

# 携程酒店爬虫（可选）：留空则不启用酒店搜索。
# 启用方式：填任意非空值（如 1），需要本地启动带 --remote-debugging-port=9222 的 Chrome
# Chrome MCP 通过 npx chrome-devtools-mcp 连接（首次会自动下载）
CTRIPE_MCP_URL=
CTRIPE_CACHE_TTL_DAYS=7
# Chrome 调试端口（默认 9222）
CHROME_DEBUG_URL=http://127.0.0.1:9222
